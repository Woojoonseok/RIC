ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://ric:CHANGE_ME@db:5432/ric
CORS_ORIGINS=https://ric.example.com
CORS_ORIGIN_REGEX=
IDENTITY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
IDENTITY_COOKIE_NAME=ric_actor
IDENTITY_COOKIE_SECURE=true
IDENTITY_COOKIE_MAX_AGE_SECONDS=31536000
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
ALLOW_LEGACY_PROJECT_CLAIMS=false
SYSTEM_ADMIN_ACTOR_IDS=
EDIT_LEASE_TTL_SECONDS=90
RUN_DATABASE_MIGRATIONS=true
