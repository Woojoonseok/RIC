ENVIRONMENT=development
DATABASE_URL=sqlite:///./ric-dev.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.7:5173
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|10\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\.168\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\.(?:1[6-9]|2[0-9]|3[01])\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])):5173$
IDENTITY_SECRET=replace-with-a-random-64-character-secret
IDENTITY_COOKIE_NAME=ric_actor
IDENTITY_COOKIE_SECURE=false
IDENTITY_COOKIE_MAX_AGE_SECONDS=31536000
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
ALLOW_LEGACY_PROJECT_CLAIMS=false
EDIT_LEASE_TTL_SECONDS=90
RUN_DATABASE_MIGRATIONS=true
VITE_API_BASE_URL=http://localhost:8000/api
